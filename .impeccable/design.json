  "components": [
    {
      "name": "Templates dropdown",
      "kind": "input",
      "refersTo": "template-select",
      "description": "Native meeting-heading select named Templates: grouped starters, custom plans when present, and save/create/manage actions. Manage templates retains the full library and editor. Desktop minimum height 44px and maximum width 260px; up to 600px, fluid width capped at 240px with 16px text.",
      "html": "<label class=\"ds-template-control\"><span class=\"ds-sr-only\">Templates</span><select class=\"ds-template-select\" aria-label=\"Templates\"><option value=\"\">Templates</option><optgroup label=\"Starter templates\"><option value=\"starter:workshop\">Workshop · 35 min</option></optgroup><optgroup label=\"Your templates\"><option value=\"custom:example\">Team review · 30 min</option></optgroup><optgroup label=\"Create &amp; manage\"><option value=\"save\">Save current agenda as template…</option><option value=\"new\">Create template…</option><option value=\"manage\">Manage templates…</option></optgroup></select></label>",
      "css": ".ds-template-control{min-width:0}.ds-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.ds-template-select{font:13px var(--f-ui,'Manrope',Arial,sans-serif);border:1px solid var(--line,#dedfd8);border-radius:999px;background:var(--panel,#fff);color:var(--fg,#1a1b17);min-height:44px;padding:10px 32px 10px 16px;max-width:260px;cursor:pointer}.ds-template-select:hover{background:var(--soft,#f0f1e9)}.ds-template-select:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}@media(max-width:600px){.ds-template-control{display:block;flex:1}.ds-template-select{font-size:16px;width:100%;max-width:240px;padding:9px 30px 9px 14px}}"
    },
    {
      "name": "Primary capsule",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acid signal for primary actions; host transport uses a larger instance.",
      "html": "<button class=\"ds-btn ds-primary\">Start meeting</button>",
      "css": ".ds-btn{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 13px;border:1px solid var(--line,#dedfd8);border-radius:999px;font-size:13px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .16s,color .16s}.ds-primary{background:var(--signal,#e5f65b);color:var(--accent,#20221b);border-color:var(--signal,#e5f65b)}.ds-primary:hover{background:var(--signal-hover,#d5e64a);border-color:var(--signal-hover,#d5e64a)}.ds-btn:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-btn:disabled{opacity:.38;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
    },
    {
      "name": "Secondary capsule",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White utility controls with quiet borders and olive hover.",
      "html": "<button class=\"ds-btn ds-secondary\">Add speaker</button>",
      "css": ".ds-btn{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 13px;border:1px solid var(--line,#dedfd8);border-radius:999px;font-size:13px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .16s,color .16s}.ds-secondary{background:var(--panel,#fff);color:var(--fg,#1a1b17)}.ds-secondary:hover{background:var(--hover,#e4e7dc);border-color:#a9ad9b}.ds-btn:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-btn:disabled{opacity:.38;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
    },
    {
      "name": "Share live capsule",
      "kind": "button",
      "refersTo": "button-share",
      "description": "Warm ink before sharing, acid signal while live.",
      "html": "<button class=\"ds-btn ds-share\">Share live <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 13px;border:1px solid var(--line,#dedfd8);border-radius:999px;font-size:13px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .16s,color .16s}.ds-share{min-height:44px;padding:9px 16px;background:var(--accent,#20221b);color:#fff;border-color:var(--accent,#20221b)}.ds-share:hover{background:#373c2d;color:#fff;border-color:#373c2d}.ds-share.ds-is-live{background:var(--signal,#e5f65b);color:var(--accent,#20221b);border-color:var(--signal,#e5f65b)}.ds-btn:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-btn:disabled{opacity:.38;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
    },
    {
      "name": "Agenda field",
      "kind": "input",
      "refersTo": "agenda-input",
      "description": "Soft-filled editable agenda name; focus stays explicit.",
      "html": "<label class=\"ds-field-label\">Speaker / topic<input class=\"ds-agenda-input\" value=\"Progress toward the goal\"></label>",
      "css": ".ds-field-label{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:grid;gap:7px;font-size:12px;color:var(--muted,#64665e)}.ds-agenda-input{font-family:var(--f-ui,'Manrope',Arial,sans-serif);height:40px;padding:6px 8px;border:1px solid transparent;border-radius:8px;background:var(--field,#f7f8f3);color:var(--fg,#1a1b17);font-size:13px;min-width:0;caret-color:#454f19}.ds-agenda-input:hover{border-color:#b7bea7}.ds-agenda-input:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}@media(max-width:600px){.ds-agenda-input{font-size:16px;min-height:44px}}"
    },
    {
      "name": "Mobile workspace navigation",
      "kind": "nav",
      "refersTo": "mobile-navigation",
      "description": "Sticky Timer / Agenda / Notes view control and the return countdown shown in Agenda or Notes. Header Google PNGs are documented in DESIGN.md and intentionally not redrawn in this SVG-only component preview.",
      "html": "<nav class=\"ds-mobile-nav\" aria-label=\"Mobile workspace\"><button aria-pressed=\"false\">Timer</button><button aria-pressed=\"true\">Agenda</button><button aria-pressed=\"false\">Notes</button></nav><button class=\"ds-peek\" aria-label=\"Return to timer\"><span class=\"ds-peek-dot\"></span><span class=\"ds-peek-name\">Progress toward the goal</span><strong>4:00</strong><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-mobile-nav{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:4px;background:var(--panel,#fff);border-radius:999px;position:sticky;top:8px;box-shadow:0 5px 20px #1a1b1710}.ds-mobile-nav button{font:600 12px var(--f-ui,'Manrope',Arial,sans-serif);border:0;background:transparent;min-height:44px;padding:9px 7px;border-radius:999px;color:var(--fg,#1a1b17);cursor:pointer;transition:background .16s,color .16s}.ds-mobile-nav button[aria-pressed=true]{background:var(--accent,#20221b);color:#fff}.ds-mobile-nav button:hover{background:var(--hover,#e4e7dc);color:var(--fg,#1a1b17)}.ds-peek{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:flex;align-items:center;gap:10px;width:100%;margin-top:18px;min-height:52px;padding:12px 16px;background:var(--ov-bg,#181a15);color:var(--ov-fg,#f8f9f1);border:0;border-radius:12px;text-align:left;cursor:pointer}.ds-peek:hover{background:var(--ov-bg,#181a15);color:var(--ov-fg,#f8f9f1)}.ds-peek-dot{width:7px;height:7px;border-radius:50%;background:var(--signal,#e5f65b);flex-shrink:0}.ds-peek-name{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;flex:1;font-size:13px}.ds-peek strong{font:600 19px var(--f-num,ui-monospace,'Cascadia Mono',Consolas,monospace);font-variant-numeric:tabular-nums}.ds-mobile-nav button:focus-visible,.ds-peek:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-mobile-nav button{transition:none}}"
    },
    {
      "name": "Timing result chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "A labeled result uses status text and a quiet semantic tint.",
      "html": "<span class=\"ds-chip\">early</span>",
      "css": ".ds-chip{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-block;width:max-content;padding:0 4px;border-radius:999px;background:color-mix(in srgb,var(--ok,#246841) 18%,transparent);color:var(--ok,#246841);font-size:12px;line-height:1.5}"
    },
    {
      "name": "Private parking panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A flat rounded utility panel with visible privacy copy.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h2>For later</h2><span class=\"ds-count\">0</span></div><p class=\"ds-panel-note\">Park the tangent. Keep the conversation moving.</p><p class=\"ds-panel-empty\">Nothing parked yet. Add a tangent or a follow-up action.</p><p class=\"ds-private\">Private to your meeting library. Never on the live screen.</p></section>",
      "css": ".ds-panel{font-family:var(--f-ui,'Manrope',Arial,sans-serif);background:var(--panel,#fff);color:var(--fg,#1a1b17);border:0;border-radius:16px;padding:24px}.ds-panel-heading{display:flex;justify-content:space-between;gap:15px;align-items:start}.ds-panel h2{font-size:18px;font-weight:650;line-height:1.4;letter-spacing:-.025em;margin:0}.ds-count{min-width:27px;height:27px;padding:3px 6px;border-radius:999px;background:#eff2e5;text-align:center;font-size:13px}.ds-panel-note{color:var(--muted,#64665e);font-size:12px;line-height:1.6;margin:6px 0 0}.ds-panel-empty{font-size:13px;color:var(--muted,#64665e);padding:16px 0 5px;line-height:1.6}.ds-private{border-top:1px solid var(--line,#dedfd8);padding-top:14px;margin-top:12px;font-size:12px;line-height:1.6;color:var(--muted,#64665e)}@media(max-width:560px){.ds-panel{padding:20px 15px}}"
    },
    {
      "name": "Host stage",
      "kind": "custom",
      "refersTo": "stage",
      "description": "Warm-black timing surface with speaker, numeric clock and next slot.",
      "html": "<section class=\"ds-stage\" aria-label=\"Current speaker timer\"><div class=\"ds-stage-top\"><span>READY</span><span>slot 4:00</span></div><div class=\"ds-speaker\">Progress toward the goal</div><div class=\"ds-clock\" role=\"timer\">4:00</div><div class=\"ds-stage-bar\"></div><div class=\"ds-stage-blocks\"><i></i><i></i><i></i></div><div class=\"ds-next\">Next: <b>Work in progress &amp; blockers</b><small>gets 8:00</small></div></section>",
      "css": ".ds-stage{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:grid;gap:13px;min-height:375px;background:var(--ov-bg,#181a15);color:var(--ov-fg,#f8f9f1);border:0;border-radius:16px;padding:28px 30px 25px}.ds-stage-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--ov-muted,#b1b4a5)}.ds-speaker{font-size:34px;font-weight:500;line-height:1.3;letter-spacing:-.03em;overflow-wrap:anywhere}.ds-clock{font-family:var(--f-num,ui-monospace,'Cascadia Mono',Consolas,monospace);font-size:clamp(88px,9vw,132px);font-weight:600;line-height:1.05;letter-spacing:-.04em;font-variant-numeric:tabular-nums;margin:3px 0 14px}.ds-stage-bar{height:4px;border-radius:3px;background:var(--ov-line,#3d4035)}.ds-stage-blocks{display:flex;gap:3px;height:5px}.ds-stage-blocks i{flex:1;border-radius:2px;background:var(--ov-up,#414536)}.ds-stage-blocks i:nth-child(2){flex:2}.ds-next{color:var(--ov-muted,#b1b4a5);font-size:18px;line-height:1.2;margin-top:13px}.ds-next b{font-weight:550;color:var(--ov-fg,#f8f9f1)}.ds-next small{display:block;margin-top:4px;font-size:12px}@media(max-width:560px){.ds-stage{padding:24px 22px 22px;min-height:320px}.ds-speaker{font-size:29px}.ds-clock{font-size:clamp(76px,22vw,110px);margin-bottom:9px}}@media(max-width:600px){.ds-stage{padding:22px;min-height:280px}.ds-speaker{font-size:28px}.ds-clock{font-size:clamp(70px,22vw,110px);margin:14px 0 22px}}"
    },
    {
      "name": "Live controller",
      "kind": "custom",
      "refersTo": "live-stage",
      "description": "The dark live display gains bounded co-host controls and host acknowledgement copy.",
      "html": "<section class=\"ds-live\"><p class=\"ds-live-title\">Daily standup</p><h1>Progress toward the goal</h1><div class=\"ds-live-clock\" role=\"timer\">4:00</div><p class=\"ds-live-state\">Ready when you are</p><div class=\"ds-live-progress\"></div><p class=\"ds-live-next\">Next: Work in progress &amp; blockers</p><div class=\"ds-remote\"><button class=\"ds-remote-primary\">Start / next</button><button>Pause / resume</button><button>Undo</button><button>Extend 1 min</button></div><p class=\"ds-command-status\">Remote control · host tab must stay open.</p></section>",
      "css": ".ds-live{font-family:var(--f-ui,'Manrope',Arial,sans-serif);padding:32px 24px;background:var(--audience-bg,#151712);color:var(--audience-fg,#f7f8f0)}.ds-live-title{color:#b0b89f;font-size:16px;margin:0 0 30px}.ds-live h1{font-size:clamp(30px,4vw,66px);font-weight:550;line-height:1.12;letter-spacing:-.04em;overflow-wrap:anywhere;margin:0}.ds-live-clock{font-family:var(--f-num,ui-monospace,'Cascadia Mono',Consolas,monospace);font-size:clamp(74px,13vw,200px);font-weight:550;line-height:1.2;letter-spacing:-.04em;color:var(--signal,#e5f65b);margin:24px 0 0}.ds-live-state{font-size:14px;color:#bec6ad}.ds-live-progress{height:6px;background:#3c4330;margin-top:36px;border-radius:6px;overflow:hidden}.ds-live-next{font-size:22px;margin-top:24px}.ds-remote{display:flex;flex-wrap:wrap;gap:9px;margin-top:30px}.ds-remote button{font-family:var(--f-ui,'Manrope',Arial,sans-serif);min-height:40px;padding:8px 13px;border:1px solid #53643a;border-radius:999px;background:#333d24;color:#f3f6e9;font-size:13px;font-weight:600;cursor:pointer;transition:background .16s,color .16s}.ds-remote button:hover{background:#556536}.ds-remote .ds-remote-primary{background:var(--signal,#e5f65b);color:var(--accent,#20221b);border-color:var(--signal,#e5f65b)}.ds-remote .ds-remote-primary:hover{background:var(--signal-hover,#d5e64a)}.ds-remote button:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-remote button:disabled{opacity:.38;cursor:not-allowed}.ds-command-status{font-size:12px;color:#bbc8a4;line-height:1.6;margin-top:15px}@media(max-width:560px){.ds-live h1{font-size:34px}.ds-live-title{font-size:14px;margin-bottom:24px}.ds-live-clock{font-size:clamp(64px,22vw,100px);margin-top:22px}.ds-live-next{font-size:20px}.ds-remote button{font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-remote button{transition:none}}"
    },
    {
      "name": "Reusable template card",
      "kind": "card",
      "refersTo": "template-card",
      "description": "Scoped peach identity, inline workshop icon, proportional slot-duration bars and explicit Use / Customize controls. Library uses two columns, then one at up to 600px.",
      "html": "<article class=\"ds-template\"><div class=\"ds-template-graphic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 2 2.8 7.2L22 12l-7.2 2.8L12 22l-2.8-7.2L2 12l7.2-2.8L12 2z\"/></svg><div class=\"ds-template-bars\" aria-hidden=\"true\"><i style=\"flex-grow:5\"></i><i style=\"flex-grow:20\"></i><i style=\"flex-grow:10\"></i></div></div><h4>Workshop</h4><p class=\"ds-template-detail\">3 slots · 35 min</p><p class=\"ds-template-description\">Make space for good ideas.</p><div class=\"ds-template-actions\"><button class=\"ds-template-use\">Use template</button><button class=\"ds-template-edit\">Customize</button></div></article>",
      "css": ".ds-template{font-family:var(--f-ui,'Manrope',Arial,sans-serif);min-width:0;border:1px solid var(--line,#dedfd8);border-radius:16px;padding:20px;background:var(--panel,#fff);color:var(--fg,#1a1b17);display:flex;flex-direction:column}.ds-template-graphic{display:flex;gap:24px;align-items:center;margin-bottom:22px}.ds-template-graphic>svg{width:24px;height:24px;flex-shrink:0;background:var(--template-peach,#f4ceb5);padding:12px;border-radius:12px}.ds-template-bars{display:flex;align-items:stretch;gap:4px;height:28px;flex:1;min-width:0;overflow:hidden}.ds-template-bars i{background:var(--template-peach,#f4ceb5);min-width:2px;flex-basis:0;border-radius:3px}.ds-template-bars i:nth-child(even){opacity:.55}.ds-template h4{font-size:19px;font-weight:650;letter-spacing:-.02em;margin:0 0 7px;overflow-wrap:anywhere}.ds-template-detail{font-size:13px;margin:0;color:var(--muted,#64665e);font-variant-numeric:tabular-nums}.ds-template-description{font-size:13px;line-height:1.5;color:var(--muted,#64665e);margin:12px 0 22px}.ds-template-actions{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto}.ds-template-actions button{font:600 12px var(--f-ui,'Manrope',Arial,sans-serif);min-height:44px;padding:8px 12px;border:1px solid transparent;border-radius:999px;cursor:pointer;transition:background .16s,color .16s}.ds-template-use{background:var(--accent,#20221b);color:#fff}.ds-template-use:hover{background:#3a3e31;color:#fff}.ds-template-edit{background:transparent;color:var(--fg,#1a1b17)}.ds-template-edit:hover{background:var(--hover,#e4e7dc)}.ds-template-actions button:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}@media(max-width:760px){.ds-template{padding:16px}.ds-template-graphic{gap:15px}.ds-template-actions{flex-wrap:wrap}}@media(max-width:600px){.ds-template-graphic{margin-bottom:16px}.ds-template-description{margin-bottom:16px}}@media(prefers-reduced-motion:reduce){.ds-template-actions button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Facilitator's broadcast / control desk",
    "overview": "The user-confirmed direction pairs a light workspace with a dark timer and uses robot.com as its visual reference. Pale mineral ground, warm-black timing surfaces, acid-yellow actions, rounded flat panels and capsule controls give the working tool a soft industrial character. Self-hosted Manrope supplies geometric lettering without copying the reference's proprietary font or imagery.\n\nThis refresh merges the implemented template library, editable template identities, official Google sign-in assets, mobile workspace views and native Templates dropdown into the incumbent world. These are scoped additions; the palette, material, typography and host/audience distinction remain the confirmed contract. `docs/base.css` supplies mechanics, then the complete `docs/workspace.css` cascade supplies effective appearance. `docs/template-ui.js`, `docs/templates.js`, `docs/mobile.js`, `docs/index.html`, `docs/live.html` and `docs/live.js` supply the corresponding surfaces and behavior. Tokens above are normative. The earlier cobalt system is superseded. There is no separate approved comp or quality-bar image; separately generated raster mockups remain unapproved and do not replace this implemented world.",
    "keyCharacteristics": [
      "Mineral light workspace and warm-black stage.",
      "Self-hosted Manrope with tabular system monospace for time.",
      "Acid-yellow primary actions and capsule navigation.",
      "Flat rounded panels separated by tone and space.",
      "Separate host workspace, audience display and remote controls.",
      "Reusable plans identified by meaningful icons and proportional agenda graphics.",
      "Focused Timer, Agenda and Notes views on phones."
    ],
    "rules": [
      {
        "name": "The Stage Separation Rule",
        "body": "Preserve the confirmed light host workspace and dark timer. The audience and controller share the full dark live surface.",
        "section": "colors"
      },
      {
        "name": "The Signal Rule",
        "body": "Use acid signal for the implemented primary actions and live timing emphasis; preserve distinct warning and overrun states.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Use the numeric stack and tabular figures for clocks, durations and timing comparisons.",
        "section": "typography"
      },
      {
        "name": "The Flat Rest Rule",
        "body": "Keep main resting surfaces flat; use the existing temporary drag shadow and subtle sticky mobile-navigation separation only in their implemented roles.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the confirmed mineral light workspace and warm-black timer.",
      "**Do** use self-hosted Manrope for interface text and tabular system monospace for timing.",
      "**Do** use acid-yellow capsules for primary actions and preserve semantic timing states.",
      "**Do** keep focused mobile views, the live return preview, the two-line phone agenda and readable mobile fields.",
      "**Do** keep template identity colors separate from semantic timer states and derive previews from real slot durations.",
      "**Do** preserve official Google artwork and the full-button / compact-header distinction.",
      "**Do** keep visible focus and reduced-motion behavior.",
      "**Do** keep planned and actual time visibly distinct.",
      "**Do** keep audience, controller and private workspace roles visually explicit."
    ],
    "donts": [
      "**Don't** restore the superseded cobalt palette or external font dependencies.",
      "**Don't** imply the working title or extracted broadcast-desk description is an approved brand name.",
      "**Don't** add ambient shadows to resting panels.",
      "**Don't** communicate timing or connection state through color alone.",
      "**Don't** expose private parking or reports in the shared display.",
      "**Don't** replace the immediate working tool with a marketing or pricing gate."
    ]
  }
}
