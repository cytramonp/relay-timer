      "kind": "nav",
      "refersTo": "navigation",
      "description": "Floating white capsule; phones use a rounded two-row utility header.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a class=\"ds-wordmark\" href=\"#\">relay<span>timer</span><b>.</b></a><div class=\"ds-nav-actions\"><button class=\"ds-nav-share\">Share live <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></button><button>My meetings</button><button class=\"ds-account\">Google sign-in</button></div></nav>",
      "css": ".ds-nav{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:68px;padding:8px 12px 8px 22px;border-radius:999px;background:var(--panel,#fff);color:var(--fg,#1a1b17)}.ds-wordmark{font-size:26px;font-weight:750;letter-spacing:-.04em;color:inherit;text-decoration:none;white-space:nowrap}.ds-wordmark span{font-weight:550}.ds-wordmark b{font-weight:550;color:#667c16}.ds-nav-actions{display:flex;gap:2px}.ds-nav-actions button{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;gap:7px;justify-content:center;min-height:44px;padding:9px 16px;border:1px solid transparent;border-radius:999px;background:transparent;color:var(--fg,#1a1b17);font-size:13px;font-weight:600;cursor:pointer;transition:background .16s,color .16s}.ds-nav-actions button:hover{background:var(--hover,#e4e7dc)}.ds-nav-actions .ds-nav-share{background:var(--accent,#20221b);color:#fff}.ds-nav-actions .ds-nav-share:hover{background:#373c2d}.ds-nav-actions .ds-account{background:#f1f3eb}.ds-nav button:focus-visible,.ds-wordmark:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}@media(max-width:560px){.ds-nav{display:block;padding:15px 14px;border-radius:16px}.ds-nav-actions{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:5px;margin-top:13px}.ds-nav-actions button{min-height:42px;padding:8px 6px;font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}"
    },
    {
      "name": "Timing result chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "A labeled result uses status text and a quiet semantic tint.",
      "html": "<span class=\"ds-chip\">early</span>",
      "css": ".ds-chip{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-block;width:max-content;padding:0 4px;border-radius:999px;background:color-mix(in srgb,var(--ok,#246841) 18%,transparent);color:var(--ok,#246841);font-size:12px;line-height:1.5}"
    },
    {
      "name": "Private parking panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A flat rounded utility panel with visible privacy copy.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h2>For later</h2><span class=\"ds-count\">0</span></div><p class=\"ds-panel-note\">Park the tangent. Keep the conversation moving.</p><p class=\"ds-panel-empty\">Nothing parked yet. Add a tangent or a follow-up action.</p><p class=\"ds-private\">Private to your meeting library. Never on the live screen.</p></section>",
      "css": ".ds-panel{font-family:var(--f-ui,'Manrope',Arial,sans-serif);background:var(--panel,#fff);color:var(--fg,#1a1b17);border:0;border-radius:16px;padding:24px}.ds-panel-heading{display:flex;justify-content:space-between;gap:15px;align-items:start}.ds-panel h2{font-size:18px;font-weight:650;line-height:1.4;letter-spacing:-.025em;margin:0}.ds-count{min-width:27px;height:27px;padding:3px 6px;border-radius:999px;background:#eff2e5;text-align:center;font-size:13px}.ds-panel-note{color:var(--muted,#64665e);font-size:12px;line-height:1.6;margin:6px 0 0}.ds-panel-empty{font-size:13px;color:var(--muted,#64665e);padding:16px 0 5px;line-height:1.6}.ds-private{border-top:1px solid var(--line,#dedfd8);padding-top:14px;margin-top:12px;font-size:12px;line-height:1.6;color:var(--muted,#64665e)}@media(max-width:560px){.ds-panel{padding:20px 15px}}"
    },
    {
      "name": "Host stage",
      "kind": "custom",
      "refersTo": "stage",
      "description": "Warm-black timing surface with speaker, numeric clock and next slot.",
      "html": "<section class=\"ds-stage\" aria-label=\"Current speaker timer\"><div class=\"ds-stage-top\"><span>READY</span><span>slot 4:00</span></div><div class=\"ds-speaker\">Progress toward the goal</div><div class=\"ds-clock\" role=\"timer\">4:00</div><div class=\"ds-stage-bar\"></div><div class=\"ds-stage-blocks\"><i></i><i></i><i></i></div><div class=\"ds-next\">Next: <b>Work in progress &amp; blockers</b><small>gets 8:00</small></div></section>",
      "css": ".ds-stage{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:grid;gap:13px;min-height:375px;background:var(--ov-bg,#181a15);color:var(--ov-fg,#f8f9f1);border:0;border-radius:16px;padding:28px 30px 25px}.ds-stage-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--ov-muted,#b1b4a5)}.ds-speaker{font-size:34px;font-weight:500;line-height:1.3;letter-spacing:-.03em;overflow-wrap:anywhere}.ds-clock{font-family:var(--f-num,ui-monospace,'Cascadia Mono',Consolas,monospace);font-size:clamp(88px,9vw,132px);font-weight:600;line-height:1.05;letter-spacing:-.04em;font-variant-numeric:tabular-nums;margin:3px 0 14px}.ds-stage-bar{height:4px;border-radius:3px;background:var(--ov-line,#3d4035)}.ds-stage-blocks{display:flex;gap:3px;height:5px}.ds-stage-blocks i{flex:1;border-radius:2px;background:var(--ov-up,#414536)}.ds-stage-blocks i:nth-child(2){flex:2}.ds-next{color:var(--ov-muted,#b1b4a5);font-size:18px;line-height:1.2;margin-top:13px}.ds-next b{font-weight:550;color:var(--ov-fg,#f8f9f1)}.ds-next small{display:block;margin-top:4px;font-size:12px}@media(max-width:560px){.ds-stage{padding:24px 22px 22px;min-height:320px}.ds-speaker{font-size:29px}.ds-clock{font-size:clamp(76px,22vw,110px);margin-bottom:9px}}"
    },
    {
      "name": "Live controller",
      "kind": "custom",
      "refersTo": "live-stage",
      "description": "The dark live display gains bounded co-host controls and host acknowledgement copy.",
      "html": "<section class=\"ds-live\"><p class=\"ds-live-title\">Daily standup</p><h1>Progress toward the goal</h1><div class=\"ds-live-clock\" role=\"timer\">4:00</div><p class=\"ds-live-state\">Ready when you are</p><div class=\"ds-live-progress\"></div><p class=\"ds-live-next\">Next: Work in progress &amp; blockers</p><div class=\"ds-remote\"><button class=\"ds-remote-primary\">Start / next</button><button>Pause / resume</button><button>Undo</button><button>Extend 1 min</button></div><p class=\"ds-command-status\">Remote control · host tab must stay open.</p></section>",
      "css": ".ds-live{font-family:var(--f-ui,'Manrope',Arial,sans-serif);padding:32px 24px;background:var(--audience-bg,#151712);color:var(--audience-fg,#f7f8f0)}.ds-live-title{color:#b0b89f;font-size:16px;margin:0 0 30px}.ds-live h1{font-size:clamp(30px,4vw,66px);font-weight:550;line-height:1.12;letter-spacing:-.04em;overflow-wrap:anywhere;margin:0}.ds-live-clock{font-family:var(--f-num,ui-monospace,'Cascadia Mono',Consolas,monospace);font-size:clamp(74px,13vw,200px);font-weight:550;line-height:1.2;letter-spacing:-.04em;color:var(--signal,#e5f65b);margin:24px 0 0}.ds-live-state{font-size:14px;color:#bec6ad}.ds-live-progress{height:6px;background:#3c4330;margin-top:36px;border-radius:6px;overflow:hidden}.ds-live-next{font-size:22px;margin-top:24px}.ds-remote{display:flex;flex-wrap:wrap;gap:9px;margin-top:30px}.ds-remote button{font-family:var(--f-ui,'Manrope',Arial,sans-serif);min-height:40px;padding:8px 13px;border:1px solid #53643a;border-radius:999px;background:#333d24;color:#f3f6e9;font-size:13px;font-weight:600;cursor:pointer;transition:background .16s,color .16s}.ds-remote button:hover{background:#556536}.ds-remote .ds-remote-primary{background:var(--signal,#e5f65b);color:var(--accent,#20221b);border-color:var(--signal,#e5f65b)}.ds-remote .ds-remote-primary:hover{background:var(--signal-hover,#d5e64a)}.ds-remote button:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-remote button:disabled{opacity:.38;cursor:not-allowed}.ds-command-status{font-size:12px;color:#bbc8a4;line-height:1.6;margin-top:15px}@media(max-width:560px){.ds-live h1{font-size:34px}.ds-live-title{font-size:14px;margin-bottom:24px}.ds-live-clock{font-size:clamp(64px,22vw,100px);margin-top:22px}.ds-live-next{font-size:20px}.ds-remote button{font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-remote button{transition:none}}"
    },
    {
      "name": "Report comparison",
      "kind": "custom",
      "refersTo": "dialog",
      "description": "A flat report surface uses ruled rows, right-aligned time and an acid export capsule.",
      "html": "<section class=\"ds-report\" aria-label=\"Session report\"><h2>How the meeting went.</h2><p>Original plan: 15:00 · Actual: 14:30</p><div class=\"ds-report-scroll\"><table><thead><tr><th>Slot</th><th>Original plan</th><th>Actual</th><th>Difference</th></tr></thead><tbody><tr><th>Progress toward the goal</th><td>4:00</td><td>4:30</td><td class=\"ds-over\">+0:30</td></tr></tbody></table></div><button class=\"ds-btn ds-report-export\">Export CSV</button></section>",
      "css": ".ds-report{font-family:var(--f-ui,'Manrope',Arial,sans-serif);padding:34px;border-radius:16px;background:var(--panel,#fff);color:var(--fg,#1a1b17)}.ds-report h2{font-size:30px;font-weight:600;line-height:1.15;letter-spacing:-.035em;margin:0 0 17px}.ds-report p{font-size:16px;font-weight:600}.ds-report-scroll{overflow-x:auto;margin:20px 0}.ds-report table{width:100%;border-collapse:collapse;font-size:13px}.ds-report th,.ds-report td{padding:13px 10px;border-bottom:1px solid var(--line,#dedfd8);text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-report th:first-child{text-align:left;white-space:normal;min-width:100px}.ds-report thead{color:var(--muted,#64665e);font-size:12px}.ds-report th{font-weight:600}.ds-over{color:#a33c2b}.ds-btn{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 13px;border:1px solid var(--line,#dedfd8);border-radius:999px;font-size:13px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .16s,color .16s}.ds-report-export{background:var(--signal,#e5f65b);color:var(--accent,#20221b);border-color:var(--signal,#e5f65b)}.ds-report-export:hover{background:var(--signal-hover,#d5e64a)}.ds-btn:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-btn:disabled{opacity:.38;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}@media(max-width:560px){.ds-report{padding:28px 20px}.ds-report h2{font-size:28px}.ds-report th,.ds-report td{padding:10px 7px;font-size:12px}}"
    }
  ],
  "narrative": {
    "northStar": "Facilitator's broadcast / control desk",
    "overview": "The user-confirmed direction pairs a light workspace with a dark timer and uses robot.com as its visual reference. Pale mineral ground, warm-black timing surfaces, acid-yellow actions, rounded flat panels and capsule controls give the working tool a soft industrial character. Self-hosted Manrope supplies geometric lettering without copying the reference's proprietary font or imagery.\n\nThis is an extraction of the final implementation: `docs/base.css` supplies mechanics, then `docs/workspace.css` supplies the effective appearance, including its later reference-driven overrides and final mobile agenda rule. `docs/index.html`, `docs/live.html` and `docs/live.js` define host, audience and controller surfaces. Tokens above are normative. The earlier cobalt system is superseded. There is no separate approved comp or quality-bar image.",
    "keyCharacteristics": [
      "Mineral light workspace and warm-black stage.",
      "Self-hosted Manrope with tabular system monospace for time.",
      "Acid-yellow primary actions and capsule navigation.",
      "Flat rounded panels separated by tone and space.",
      "Separate host workspace, audience display and remote controls."
    ],
    "rules": [
      {
        "name": "The Stage Separation Rule",
        "body": "Preserve the confirmed light host workspace and dark timer. The audience and controller share the full dark live surface.",
        "section": "colors"
      },
      {
        "name": "The Signal Rule",
        "body": "Use acid signal for the implemented primary actions and live timing emphasis; preserve distinct warning and overrun states.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Use the numeric stack and tabular figures for clocks, durations and timing comparisons.",
        "section": "typography"
      },
      {
        "name": "The Flat Rest Rule",
        "body": "Keep resting surfaces flat; reserve the existing shadow for drag feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the confirmed mineral light workspace and warm-black timer.",
      "**Do** use self-hosted Manrope for interface text and tabular system monospace for timing.",
      "**Do** use acid-yellow capsules for primary actions and preserve semantic timing states.",
      "**Do** keep the final two-line phone agenda, visible focus and reduced-motion behavior.",
      "**Do** keep planned and actual time visibly distinct.",
      "**Do** keep audience, controller and private workspace roles visually explicit."
    ],
    "donts": [
      "**Don't** restore the superseded cobalt palette or external font dependencies.",
      "**Don't** imply the working title or extracted broadcast-desk description is an approved brand name.",
      "**Don't** add ambient shadows to resting panels.",
      "**Don't** communicate timing or connection state through color alone.",
      "**Don't** expose private parking or reports in the shared display.",
      "**Don't** replace the immediate working tool with a marketing or pricing gate."
    ]
  }
}
