  "components": [
    {
      "name": "Primary capsule",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acid signal for primary actions; host transport uses a larger instance.",
      "html": "<button class=\"ds-btn ds-primary\">Start meeting</button>",
      "css": ".ds-btn{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 13px;border:1px solid var(--line,#dedfd8);border-radius:999px;font-size:13px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .16s,color .16s}.ds-primary{background:var(--signal,#e5f65b);color:var(--accent,#20221b);border-color:var(--signal,#e5f65b)}.ds-primary:hover{background:var(--signal-hover,#d5e64a);border-color:var(--signal-hover,#d5e64a)}.ds-btn:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-btn:disabled{opacity:.38;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
    },
    {
      "name": "Secondary capsule",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White utility controls with quiet borders and olive hover.",
      "html": "<button class=\"ds-btn ds-secondary\">Add speaker</button>",
      "css": ".ds-btn{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 13px;border:1px solid var(--line,#dedfd8);border-radius:999px;font-size:13px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .16s,color .16s}.ds-secondary{background:var(--panel,#fff);color:var(--fg,#1a1b17)}.ds-secondary:hover{background:var(--hover,#e4e7dc);border-color:#a9ad9b}.ds-btn:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-btn:disabled{opacity:.38;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
    },
    {
      "name": "Share live capsule",
      "kind": "button",
      "refersTo": "button-share",
      "description": "Warm ink before sharing, acid signal while live.",
      "html": "<button class=\"ds-btn ds-share\">Share live <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{font-family:var(--f-ui,'Manrope',Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:8px 13px;border:1px solid var(--line,#dedfd8);border-radius:999px;font-size:13px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .16s,color .16s}.ds-share{min-height:44px;padding:9px 16px;background:var(--accent,#20221b);color:#fff;border-color:var(--accent,#20221b)}.ds-share:hover{background:#373c2d;color:#fff;border-color:#373c2d}.ds-share.ds-is-live{background:var(--signal,#e5f65b);color:var(--accent,#20221b);border-color:var(--signal,#e5f65b)}.ds-btn:focus-visible{outline:2px solid var(--focus,#687c16);outline-offset:4px}.ds-btn:disabled{opacity:.38;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
