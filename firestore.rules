rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/meetings/{meetingId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id','title','updatedAt','deleted','state'])
        && request.resource.data.id == meetingId
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.updatedAt is int
        && request.resource.data.deleted is bool
        && (request.resource.data.state is map || (request.resource.data.deleted && request.resource.data.state == null));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
